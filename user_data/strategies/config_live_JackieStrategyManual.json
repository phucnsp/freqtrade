
{
    // this session might be changed between strategies
    "strategy": "JackieStrategyManual",
    "bot_name": "live_JackieStrategyManual",
    "dry_run": false,
    "db_url": "sqlite:///tradesv3.live.JackieStrategyManual.sqlite",
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "jackie",
        "ws_token": "jackie",
        "CORS_origins": ["http://localhost:8080"],
        "username": "jackie",
        "password": "jackie"
    },
    "available_capital": 3000, // each bot only allow to use this amount, even the wallet has more than that
    "stake_amount": "unlimited", // Amount use for each trade. "unlimited" use all available balance.
    "max_open_trades": 1,  // set 1 so that all available_capital will go ALL, to customer_stake_amount, so that we can adjust it all as we want
    "minimal_roi": {"0": 0.3, "4320": 0.0}, // if 30% profit take immediately, if 3 days without profit, exit it
    "timeframe": "1h",
    ///////////////// separator ///////////////////////
    "$schema": "https://schema.freqtrade.io/schema.json",
    "stake_currency": "USDT",
    "tradable_balance_ratio": 1.0,
    "fiat_display_currency": "USD",
    // "timeframe-detail": "5m",
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "spot",
    "margin_mode": "",
    "unfilledtimeout": {
        "entry": 43200, // one month, long bcz we wait for proper price
        "exit": 30,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false,
        "stoploss_on_exchange_interval": 60
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing":{
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {"enableRateLimit": true},
        "ccxt_async_config": {
            "enableRateLimit": true,
            "rateLimit": 200
        },
        "pair_whitelist": [
            "ADA/USDT"
        ],
        "pair_blacklist": [
            "BNB/.*"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "recursive_strategy_search" : true,
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": "",
        "allow_custom_messages": true,
        "notification_settings": {
            "status": "silent",
            "warning": "on",
            "startup": "off",
            "entry": "silent",
            "entry_fill": "on",
            "entry_cancel": "silent",
            "exit": {
                "roi": "silent",
                "emergency_exit": "on",
                "force_exit": "on",
                "exit_signal": "silent",
                "trailing_stop_loss": "on",
                "stop_loss": "on",
                "stoploss_on_exchange": "on",
                "custom_exit": "silent",  // custom_exit without specifying an exit reason
                "partial_exit": "on",
                // "custom_exit_message": "silent",  // Disable individual custom exit reasons
                "*": "off"  // Disable all other exit reasons
            },
            // "exit": "off",  // Simplistic configuration to disable all exit messages
            "exit_cancel": "on",
            "exit_fill": "on",
            "protection_trigger": "off",
            "protection_trigger_global": "on",
            "strategy_msg": "off",
            "show_candle": "off"
        },
        "reload": true,
        "balance_dust_level": 0.01
    },
    "initial_state": "running",
    "force_entry_enable": true,
    "internals": {
        "process_throttle_secs": 5
    },
    "webhook": {
        "enabled": true,
        "url": "http://webhook:8083/closed_trade",
        "entry": {
            "value1": "entry:{pair}",
            "value2": "price_limit:{limit:8f}",
            "value3": "stake_amount:{stake_amount:8f}_{stake_currency}"
        },
        "entry_cancel": {
            "value1": "entry_cancel:{pair}",
            "value2": "price_limit:{limit:8f}",
            "value3": "stake_amount:{stake_amount:8f}_{stake_currency}"
        },
         "entry_fill": {
            "value1": "entry_fill:{pair}",
            "value2": "price_filled:{open_rate:8f}",
            "value3": "stake_amount:{stake_amount:8f}_{stake_currency}"
        },
        "exit": {
            "value1": "exit:{pair}",
            "value2": "price_limit:{limit:8f}",
            "value3": "profit:{profit_amount:8f}_{stake_currency}_({profit_ratio})"
        },
        "exit_cancel": {
            "value1": "exit_cancel:{pair}",
            "value2": "price_limit:{limit:8f}",
            "value3": "profit:{profit_amount:8f}_{stake_currency}_({profit_ratio})"
        },
        "exit_fill": {
            "value1": "exit_fill:{pair}",
            "value2": "price_filled:{close_rate:8f}.",
            "value3": "profit:{profit_amount:8f}_{stake_currency}_({profit_ratio})"
        },
        "status": {
            "value1": "Status: {status}",
            "value2": "",
            "value3": ""
        }
    },
    "discord": {
        "enabled": true,
        "webhook_url": "https://discord.com/api/webhooks/1381254652053553293/AJZKzUYhuDca8n63QlaTNI9eF_Hm42mSlgrl6JD2lk8Ne5yGp_SEya8XZgw276xE_UL_",
        "exit_fill": [
            {"Trade ID": "{trade_id}"},
            {"Exchange": "{exchange}"},
            {"Pair": "{pair}"},
            {"Direction": "{direction}"},
            {"Open rate": "{open_rate}"},
            {"Close rate": "{close_rate}"},
            {"Amount": "{amount}"},
            {"Open date": "{open_date:%Y-%m-%d %H:%M:%S}"},
            {"Close date": "{close_date:%Y-%m-%d %H:%M:%S}"},
            {"Profit": "{profit_amount} {stake_currency}"},
            {"Profitability": "{profit_ratio:.2%}"},
            {"Enter tag": "{enter_tag}"},
            {"Exit Reason": "{exit_reason}"},
            {"Strategy": "{strategy}"},
            {"Timeframe": "{timeframe}"},
        ],
        "entry": [
            {"Trade ID": "{trade_id}"},
            {"Exchange": "{exchange}"},
            {"Pair": "{pair}"},
            {"Direction": "{direction}"},
            {"Open rate": "{open_rate}"},
            {"Amount": "{amount}"},
            {"Open date": "{open_date:%Y-%m-%d %H:%M:%S}"},
            {"Enter tag": "{enter_tag}"},
            {"Strategy": "{strategy} {timeframe}"},
        ],
        "entry_fill": [
            {"Trade ID": "{trade_id}"},
            {"Exchange": "{exchange}"},
            {"Pair": "{pair}"},
            {"Direction": "{direction}"},
            {"Open rate": "{open_rate}"},
            {"Amount": "{amount}"},
            {"Open date": "{open_date:%Y-%m-%d %H:%M:%S}"},
            {"Enter tag": "{enter_tag}"},
            {"Strategy": "{strategy} {timeframe}"},
        ]
    }
}